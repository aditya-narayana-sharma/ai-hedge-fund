# For running LLMs hosted by anthropic (claude-3-5-sonnet, claude-3-opus, claude-3-5-haiku)
# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# For running LLMs hosted by deepseek (deepseek-chat, deepseek-reasoner, etc.)
# Get your DeepSeek API key from https://deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# For running LLMs hosted by groq (deepseek, llama3, etc.)
# Get your Groq API key from https://groq.com/
GROQ_API_KEY=your-groq-api-key

# For running LLMs hosted by gemini (gemini-2.5-flash, gemini-2.5-pro)
# Get your Google API key from https://ai.dev/
GOOGLE_API_KEY=your-google-api-key

# For getting financial data to power the hedge fund
# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# For running LLMs hosted by openai (gpt-4o, gpt-4o-mini, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# Optional: point the OpenAI client at an OpenAI-compatible gateway
# (Azure OpenAI, LiteLLM, vLLM, OpenRouter, ...). Leave unset for api.openai.com.
# OPENAI_API_BASE=https://your-gateway.example.com/v1

# Optional: host running the Ollama daemon. Defaults to localhost.
# Inside docker-compose this is set to the `ollama` service name.
# OLLAMA_HOST=localhost

# Optional: full base URL of the Ollama daemon. Defaults to http://$OLLAMA_HOST:11434.
# Setting this also tells the CLI it is running inside a container, so it will
# not try to install or start a local Ollama binary.
# OLLAMA_BASE_URL=http://localhost:11434

# --- Backend API (app/backend) ----------------------------------------------

# Optional: comma-separated browser origins allowed to call the API.
# Defaults to the two Vite dev origins.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: when set, every request except the health endpoints must send
# `Authorization: Bearer <token>`. Unset means no authentication, which suits
# a localhost-only desktop run.
# API_AUTH_TOKEN=

# Optional: how many runs one client may start per minute, since each run
# spends money at an LLM provider. 0 disables the limit. Defaults to 10.
# RATE_LIMIT_PER_MINUTE=10
