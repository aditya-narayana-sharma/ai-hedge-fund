# For running LLMs hosted by anthropic (claude-3-5-sonnet, claude-3-opus, claude-3-5-haiku)
# Get your Anthropic API key from https://anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# For running LLMs hosted by deepseek (deepseek-chat, deepseek-reasoner, etc.)
# Get your DeepSeek API key from https://deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key

# For running LLMs hosted by groq (deepseek, llama3, etc.)
# Get your Groq API key from https://groq.com/
GROQ_API_KEY=your-groq-api-key

# For running LLMs hosted by gemini (gemini-2.5-flash, gemini-2.5-pro)
# Get your Google API key from https://ai.dev/
GOOGLE_API_KEY=your-google-api-key

# For getting financial data to power the hedge fund
# Get your Financial Datasets API key from https://financialdatasets.ai/
FINANCIAL_DATASETS_API_KEY=your-financial-datasets-api-key

# For running LLMs hosted by openai (gpt-4o, gpt-4o-mini, etc.)
# Get your OpenAI API key from https://platform.openai.com/
OPENAI_API_KEY=your-openai-api-key

# Optional: point the OpenAI client at an OpenAI-compatible gateway
# (Azure OpenAI, LiteLLM, OpenRouter, vLLM, ...). Leave unset for api.openai.com.
# OPENAI_API_BASE=https://your-gateway.example.com/v1

# Optional: Ollama connection for local LLM inference.
# OLLAMA_HOST is the hostname only; OLLAMA_BASE_URL is the full URL and wins when set.
# Inside Docker these are provided by docker-compose.yml (host.docker.internal / ollama).
# OLLAMA_HOST=localhost
# OLLAMA_BASE_URL=http://localhost:11434

# --- Web backend (all optional; unset keeps the local default) ---
# Comma-separated browser origins allowed to call the API.
# AI_HEDGE_FUND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# When set, every POST requires this value in the X-API-Key header.
# AI_HEDGE_FUND_API_KEY=
# Requests allowed per client per window. 0 or unset disables the limiter.
# AI_HEDGE_FUND_RATE_LIMIT=0
# AI_HEDGE_FUND_RATE_LIMIT_WINDOW=60
# SQLAlchemy URL. Unset keeps runs in memory only.
# AI_HEDGE_FUND_DATABASE_URL=sqlite:///./ai_hedge_fund.db
# Cache TTL in seconds. Unset means historical data does not expire.
# AI_HEDGE_FUND_CACHE_TTL=
# Directory for the on-disk API cache. Unset keeps it in memory.
# AI_HEDGE_FUND_CACHE_DIR=
# Days after a report period ends before fundamentals are treated as public.
# AI_HEDGE_FUND_PUBLICATION_LAG_DAYS=45
